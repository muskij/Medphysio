# Copy this file to .env.local and fill in real values.

# Random long string used to sign login sessions. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=replace-with-a-long-random-string

# --- AI Q&A (Tier 1 & 2) ---
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
# Optional: override the model id (see https://docs.anthropic.com for current ids)
ANTHROPIC_MODEL=claude-sonnet-5

# --- Payments (Tier 3) ---
# Get keys at https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# From the Stripe CLI or your webhook endpoint settings
STRIPE_WEBHOOK_SECRET=
# Used to build Stripe redirect URLs, e.g. http://localhost:3000 or your live domain
NEXT_PUBLIC_SITE_URL=http://localhost:3000
